# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Autonomous Procurement Assistant
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=procurement_assistant

# ---------------------------------------------------------------------------
# Security  -  REQUIRED: generate your own before deploying
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# CORS (comma separated)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# File storage  -  originals are never stored in MongoDB
#   local  = filesystem at STORAGE_LOCAL_PATH
#   (s3 / minio can be added behind the same StorageBackend interface)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=../storage
MAX_UPLOAD_SIZE_MB=25

# ---------------------------------------------------------------------------
# AI provider
#   openrouter = OpenRouter (default). Get a key at https://openrouter.ai/keys
#   ollama     = local Ollama server, no key (https://ollama.com)
#   gemini     = Google Gemini direct (GEMINI_API_KEY)
#   none       = AI disabled; heuristic extraction and template drafts are used
# Free OpenRouter model IDs end in ":free" and are rate-limited.
# ---------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_APP_URL=http://localhost:5173
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_REQUEST_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# OCR
#   auto      = Tesseract if installed, else RapidOCR (pip-only, no binary)
#   tesseract = force Tesseract (needs the system binary)
#   rapidocr  = force RapidOCR
#   none      = disable OCR entirely
# TESSERACT_CMD only needed if tesseract.exe is not on PATH.
# ---------------------------------------------------------------------------
OCR_ENGINE=auto
TESSERACT_CMD=
PDF_TEXT_MIN_CHARS_PER_PAGE=60

# ---------------------------------------------------------------------------
# Background processing
# ---------------------------------------------------------------------------
PROCESSING_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Supplier scoring weights (must be meaningful relative to each other;
# they are normalised to sum to 1 at runtime)
# ---------------------------------------------------------------------------
SCORE_WEIGHT_PRICE=0.40
SCORE_WEIGHT_DELIVERY=0.20
SCORE_WEIGHT_PAYMENT=0.15
SCORE_WEIGHT_RELIABILITY=0.15
SCORE_WEIGHT_OTHER=0.10

# ---------------------------------------------------------------------------
# Product matching thresholds
#   >= MATCH_AUTO_THRESHOLD    -> automatic match
#   >= MATCH_REVIEW_THRESHOLD  -> matched but flagged for review
#   below                      -> not matched; manual review required
# ---------------------------------------------------------------------------
MATCH_AUTO_THRESHOLD=0.86
MATCH_REVIEW_THRESHOLD=0.62

# ---------------------------------------------------------------------------
# Secrets at rest (OAuth refresh tokens). Derived from JWT_SECRET_KEY if empty.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Gmail ingestion (Google OAuth 2.0, read-only)
#   Google Cloud Console -> enable Gmail API -> OAuth consent screen (External,
#   Testing, add test users) -> OAuth client (Web application) with the redirect
#   URI below. See docs/ROADMAP.md.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/channels/gmail/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_SYNC_QUERY=newer_than:30d subject:(quotation OR quotations OR quote OR RFQ OR "price list" OR proforma OR "rate list")
GMAIL_MAX_MESSAGES_PER_SYNC=25
GMAIL_SYNC_INTERVAL_MINUTES=15

# --- Procurement automation, agents, analytics ---
NEGOTIATION_DEFAULT_DISCOUNT_PCT=5.0
NEGOTIATION_WEAK_CRITERION_SCORE=0.5
ASSISTANT_MAX_TOOL_ROUNDS=6
AGENT_MAX_STEPS=12
# The monitor agent starts sourcing on its own and chases overdue deliveries.
# It only ever creates drafts that wait for approval. Set false to require a button press.
AGENT_AUTOPILOT=true
AGENT_AUTOPILOT_MIN_QUOTATIONS=2
AGENT_WATCHDOG_INTERVAL_MINUTES=60
EXTRACTION_SELF_CORRECTION=true
ML_MIN_RETRAIN_ORDERS=50
