# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Autonomous Procurement Assistant
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=procurement_assistant

# ---------------------------------------------------------------------------
# Security  -  REQUIRED: generate your own before deploying
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# CORS (comma separated)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# File storage  -  originals are never stored in MongoDB
#   local  = filesystem at STORAGE_LOCAL_PATH
#   (s3 / minio can be added behind the same StorageBackend interface)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=../storage
MAX_UPLOAD_SIZE_MB=25

# ---------------------------------------------------------------------------
# AI provider
#   AI_PROVIDER=gemini requires GEMINI_API_KEY (https://aistudio.google.com/apikey)
#   AI_PROVIDER=none    disables AI; the system degrades gracefully to a
#                       deterministic heuristic extractor and a computed summary
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_REQUEST_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# OCR
#   auto      = Tesseract if installed, else RapidOCR (pip-only, no binary)
#   tesseract = force Tesseract (needs the system binary)
#   rapidocr  = force RapidOCR
#   none      = disable OCR entirely
# TESSERACT_CMD only needed if tesseract.exe is not on PATH.
# ---------------------------------------------------------------------------
OCR_ENGINE=auto
TESSERACT_CMD=
PDF_TEXT_MIN_CHARS_PER_PAGE=60

# ---------------------------------------------------------------------------
# Background processing
# ---------------------------------------------------------------------------
PROCESSING_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Supplier scoring weights (must be meaningful relative to each other;
# they are normalised to sum to 1 at runtime)
# ---------------------------------------------------------------------------
SCORE_WEIGHT_PRICE=0.40
SCORE_WEIGHT_DELIVERY=0.20
SCORE_WEIGHT_PAYMENT=0.15
SCORE_WEIGHT_RELIABILITY=0.15
SCORE_WEIGHT_OTHER=0.10

# ---------------------------------------------------------------------------
# Product matching thresholds
#   >= MATCH_AUTO_THRESHOLD    -> automatic match
#   >= MATCH_REVIEW_THRESHOLD  -> matched but flagged for review
#   below                      -> not matched; manual review required
# ---------------------------------------------------------------------------
MATCH_AUTO_THRESHOLD=0.86
MATCH_REVIEW_THRESHOLD=0.62
