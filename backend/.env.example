# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Autonomous Procurement Assistant
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=procurement_assistant

# ---------------------------------------------------------------------------
# Security  -  REQUIRED: generate your own before deploying
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# CORS (comma separated)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# File storage  -  originals are never stored in MongoDB
#   local  = filesystem at STORAGE_LOCAL_PATH
#   (s3 / minio can be added behind the same StorageBackend interface)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=../storage
MAX_UPLOAD_SIZE_MB=25

# ---------------------------------------------------------------------------
# AI providers - one key per vendor; they can all be used at the same time.
# Every vendor speaks the OpenAI chat-completions format, so no vendor SDK is needed.
#   gemini     = Google Gemini   key: https://aistudio.google.com/apikey  (has a free tier)
#   grok       = xAI Grok        key: https://console.x.ai
#   qwen       = Alibaba Qwen    key: https://modelstudio.console.alibabacloud.com
#   ollama     = local Ollama server, no key (https://ollama.com)
#   openrouter = optional aggregator, not required
#   none       = AI disabled; heuristic extraction and template drafts are used
# AI_PROVIDER is the default vendor for any task not listed in LLM_TASK_MODELS.
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast

QWEN_API_KEY=
# International accounts. Mainland China accounts: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_APP_URL=http://localhost:5173

# --- A different model per task, and the LLM council ---
# A model is written vendor:model (e.g. qwen:qwen-plus). Without a vendor, AI_PROVIDER's vendor is used.
# Tasks: extraction, matching, recommendation, supervisor, drafting, negotiation, critic, assistant, hsn.
# "council" hands a text-writing task (recommendation, critic, drafting, supervisor) to the council;
# tool-using tasks (negotiation, assistant) need one model that supports tool calling.
# Example: LLM_TASK_MODELS=extraction=gemini:gemini-2.5-flash,negotiation=grok:grok-4-fast,hsn=qwen:qwen-plus,critic=council,recommendation=council
LLM_TASK_MODELS=
# Council members read each other's answers anonymously, then the monitor decides.
# Pick 2-4 models from DIFFERENT vendors so their mistakes don't overlap.
# Example: COUNCIL_MODELS=grok:grok-4-fast,qwen:qwen-plus,gemini:gemini-2.5-flash
COUNCIL_MODELS=
# Example: COUNCIL_MONITOR_MODEL=gemini:gemini-2.5-pro
COUNCIL_MONITOR_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# OCR
#   auto      = Tesseract if installed, else RapidOCR (pip-only, no binary)
#   tesseract = force Tesseract (needs the system binary)
#   rapidocr  = force RapidOCR
#   none      = disable OCR entirely
# TESSERACT_CMD only needed if tesseract.exe is not on PATH.
# ---------------------------------------------------------------------------
OCR_ENGINE=auto
TESSERACT_CMD=
PDF_TEXT_MIN_CHARS_PER_PAGE=60

# ---------------------------------------------------------------------------
# Background processing
# ---------------------------------------------------------------------------
PROCESSING_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Supplier scoring weights (must be meaningful relative to each other;
# they are normalised to sum to 1 at runtime)
# ---------------------------------------------------------------------------
SCORE_WEIGHT_PRICE=0.40
SCORE_WEIGHT_DELIVERY=0.20
SCORE_WEIGHT_PAYMENT=0.15
SCORE_WEIGHT_RELIABILITY=0.15
SCORE_WEIGHT_OTHER=0.10

# ---------------------------------------------------------------------------
# Product matching thresholds
#   >= MATCH_AUTO_THRESHOLD    -> automatic match
#   >= MATCH_REVIEW_THRESHOLD  -> matched but flagged for review
#   below                      -> not matched; manual review required
# ---------------------------------------------------------------------------
MATCH_AUTO_THRESHOLD=0.86
MATCH_REVIEW_THRESHOLD=0.62

# ---------------------------------------------------------------------------
# Secrets at rest (OAuth refresh tokens). Derived from JWT_SECRET_KEY if empty.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Gmail ingestion (Google OAuth 2.0, read-only)
#   Google Cloud Console -> enable Gmail API -> OAuth consent screen (External,
#   Testing, add test users) -> OAuth client (Web application) with the redirect
#   URI below. See docs/ROADMAP.md.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/channels/gmail/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_SYNC_QUERY=newer_than:30d subject:(quotation OR quotations OR quote OR RFQ OR "price list" OR proforma OR "rate list")
GMAIL_MAX_MESSAGES_PER_SYNC=25
GMAIL_SYNC_INTERVAL_MINUTES=15
# Filing purchase orders to Drive asks for the drive.file scope at sign-in.
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_FOLDER_ID=

# --- Procurement automation, agents, analytics ---
NEGOTIATION_DEFAULT_DISCOUNT_PCT=5.0
NEGOTIATION_WEAK_CRITERION_SCORE=0.5
ASSISTANT_MAX_TOOL_ROUNDS=6
AGENT_MAX_STEPS=12
# The monitor agent starts sourcing on its own and chases overdue deliveries.
# It only ever creates drafts that wait for approval. Set false to require a button press.
AGENT_AUTOPILOT=true
AGENT_AUTOPILOT_MIN_QUOTATIONS=2
AGENT_WATCHDOG_INTERVAL_MINUTES=60
EXTRACTION_SELF_CORRECTION=true
ML_MIN_RETRAIN_ORDERS=50
